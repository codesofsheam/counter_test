mergeParallel( R merge
    language("
             effective R,W,L       \n
             checkForZero = prod ( R )       \n
             if(checkForZero != 0)       \n
               R = 1/sum(1/R)        \n
             else        \n
               R = 0        \n
             checkForZeroW = prod ( W )       \n
             checkForZeroL = prod ( L )       \n
             if(checkForZeroW && checkForZeroL) {      \n
               P = sum(W*L)        \n
               Q = sum(W/L)        \n
               W = sqrt(P*Q)        \n
               L = sqrt(P/Q) }       \n
             "
            ))
mergeSeries( R merge
    language("
             effective R,W,L       \n
             R = sum(R)        \n
             checkForZeroW = prod ( W )       \n
             checkForZeroL = prod ( L )       \n
             if(checkForZeroW && checkForZeroL) {      \n
               P = sum(W*L)        \n
               Q = sum(L/W)        \n
               W = sqrt(P/Q)        \n
               L = sqrt(P*Q) }       \n
             "
            ))
mergeParallel( C merge
    language("
             effective C,A,P        \n
             C = sum(C)        \n
             A = sum(A)        \n
             P = sum(P)        \n
             "
            ))
mergeSeries( C merge
    language("
             effective C        \n
             checkForZero = prod ( C )       \n
             if(checkForZero != 0)       \n
               C = 1/sum(1/C)        \n
             else        \n
               C = 0        \n
             "
            ))
mergeParallel( Q merge
    language("
           effective A,W,L        \n
           A = sum(A)        \n
           P = sum(W*L)      \n
           Q = sum(W/L)      \n
           W = sqrt(P*Q)      \n
           L = sqrt(P/Q) }     \n
             "
            ))
